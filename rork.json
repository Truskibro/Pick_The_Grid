{
  "$schema": "https://rork.com/schema/rork.json",
  "crons": [
    {
      "name": "sync-race-results",
      "schedule": "*/15 * * * *",
      "target": "https://0gh0lza74yba9xaelm3uk-results-worker.rork.live/cron/sync-results",
      "payload": { "series": "all" }
    }
  ],
  "apps": [
    {
      "name": "Expo",
      "path": "expo",
      "framework": "react-native"
    },
    {
      "name": "Backend",
      "path": "backend",
      "framework": "supabase"
    },
    {
      "name": "Results Worker",
      "path": "results-worker",
      "framework": "web",
      "settings": {
        "kind": "server-only"
      }
    }
  ]
}
